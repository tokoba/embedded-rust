{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Debug (probe-rs) button_led",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo build (button_led)",
      "chip": "STM32F767ZITx",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": false
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/button_led",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "Defmt",
              "showTimestamp": true
            }
          ]
        }
      ],
      "consoleLogLevel": "Info"
    },
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Release (probe-rs) button_led",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo build release (button_led)",
      "chip": "STM32F767ZITx",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": false
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/release/button_led",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "Defmt",
              "showTimestamp": true
            }
          ]
        }
      ],
      "consoleLogLevel": "Info"
    }
  ]
}
