{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xtask: list host packages",
      "type": "shell",
      "command": "cargo xtask list-host-packages",
      "problemMatcher": []
    },
    {
      "label": "xtask: clippy host",
      "type": "shell",
      "command": "cargo xtask clippy-host",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "xtask: test host",
      "type": "shell",
      "command": "cargo xtask test-host",
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "xtask: clippy embedded",
      "type": "shell",
      "command": "cargo xtask clippy-embedded",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "xtask: build embedded",
      "type": "shell",
      "command": "cargo xtask build-embedded",
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "xtask: ci",
      "type": "shell",
      "command": "cargo xtask ci",
      "group": "build",
      "problemMatcher": "$rustc"
    }
  ]
}
