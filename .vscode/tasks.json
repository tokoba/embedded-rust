{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build (blinky_single_task)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--bin", "blinky"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo build (blinky_multi_task)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--bin", "blinky", "--features", "multitask"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo build (button_exti)",
